{
  "name": "workroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/src/main.ts",
    "start": "node --disable-warning=ExperimentalWarning server/src/main.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && npm run -w web typecheck",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"server/test/**/*.test.ts\"",
    "build:web": "npm run -w web build",
    "acceptance": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 server/test/acceptance-loop.test.ts server/test/proof.test.ts && npm run build:web && npm run -w web e2e",
    "sandbox:image": "node server/sandbox/build-image.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@hono/node-server": "2.1.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "1.1.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "croner": "11.0.0",
    "docx": "9.15.3",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "hono": "4.13.17",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "marked": "18.1.3",
    "node-html-parser": "9.0.7",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "tesseract.js": "7.0.0",
    "unpdf": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "playwright-core": "1.63.0"
  }
}
